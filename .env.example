# PostgreSQL connection URL for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gamedex?schema=public"

# Backend server port
PORT=3000

# Steam Web API Key (Obligatoria para sincronizar bibliotecas y cuentas de usuarios de Steam)
# Obtén tu clave gratuita en: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""
